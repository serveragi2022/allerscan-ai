# ---- AI provider (server-side only; never prefix with NEXT_PUBLIC_) ----
# Which vision provider to use: "anthropic" (default) or "openai"
# ("openai" works with any OpenAI-compatible chat completions endpoint)
AI_PROVIDER=anthropic

# API key for the selected provider
AI_API_KEY=

# Vision-capable model ID for the selected provider
# Example (anthropic): claude-sonnet-4-5   Example (openai): gpt-4o
AI_MODEL=

# Optional: override the API base URL (e.g. for an OpenAI-compatible gateway)
# AI_BASE_URL=

# Optional: speed up scans on reasoning ("thinking") models by lowering effort,
# e.g. low or minimal. Accepted values depend on the provider and model.
# AI_REASONING_EFFORT=low

# Optional: request timeout in milliseconds (keep under your function time limit)
# AI_TIMEOUT_MS=

# Optional: rate limit per IP per minute (default 10)
# RATE_LIMIT_PER_MINUTE=10

# Optional: Upstash Redis REST credentials for a rate limit that works across
# serverless instances. Without them an in-memory limiter is used (best effort).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
